# Игнорируемые файлы для Git

# Python
*.pyc
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Временные файлы
*.tmp
*.bak
*.log

# Vercel
.vercel

# Секреты — НИКОГДА не коммитить
.env
.env.*
!.env.example
*.local.md

# Пароли быстрого входа для локальной разработки
dev-logins.js
!dev-logins.example.js

# PowerShell скрипты для разработки (опционально, можно закоммитить)
# *.ps1
tests/sheets.json

# Выгрузки данных из базы — рабочие цифры, в git им не место
backup/

# ── Репозиторий ПУБЛИЧНЫЙ: всё, где реальные люди и цифры, — только локально ──
# Исходные книги Excel: штатные расписания, тарификация, планы, списки
# сотрудников. Тестам они нужны с диска, в git их нет
excel/
*.xlsx
*.xls
*.xlsm
*.csv
*.pdf
*.docx
*.doc
# Списки сотрудников, выданные пароли, личные настройки
*.local.*
scripts/*.local.*
# Ключи и сертификаты ЭЦП, контейнеры НУЦ
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
