.git
.gitignore
.vercel
.vercelignore
.env*
node_modules
Dockerfile
.dockerignore
docker-compose.yml

# Скрипты разработки и анализа
*.py
*.ps1
__pycache__/
*.pyc

# Документация и исходные выгрузки
*.md
*.xlsx
*.txt
*.yaml
package.json
pnpm-lock.yaml
.htmlhintrc

# Пароли быстрого входа — только для локальной разработки
dev-logins.js
dev-logins.example.js
scripts/

# Служебное
*.log
*.tmp
*.bak
Thumbs.db
desktop.ini

# Исходные книги Excel — только для разработки
excel/

# Выгрузки базы с реальными данными — никогда не публикуются
backup/

# Инструменты качества кода — только для разработки
eslint.config.mjs
tsconfig.json
types/

# ── Не публиковать на сайте ─────────────────────────────────────
# Vercel CLI при наличии .vercelignore НЕ читает .gitignore — поэтому всё
# локальное и служебное перечислено здесь отдельно (сборка раздаёт любые
# *.json, а в scripts/ лежат списки сотрудников)
scripts/
tests/
supabase/
*.local.*
*.csv
*.xlsx
*.xls
*.pdf
*.doc
*.docx
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt

# Серверная функция Vercel (проверка ЭЦП) — в статическом nginx не нужна
api/
