# Шаблон переменных окружения. Скопировать в .env и заполнить.
# .env в git не попадает (см. .gitignore).

# ── Supabase ──────────────────────────────────────────────────────
# URL проекта и publishable (anon) ключ — ПУБЛИЧНЫЕ, попадают в браузер.
# Дублируются в auth.js, потому что проект деплоится как статика без сборки.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_KEY="sb_publishable_..."

# Service role / secret ключ — ТОЛЬКО для серверного кода.
# Никогда не вставлять в html/js, которые отдаются браузеру.
SUPABASE_SECRET_KEY="sb_secret_..."

DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
